    {
      "type": "table",
      "title": "Blocked by reason",
      "description": "Reason comes from the IP's CrowdSec alerts (last 30 days); IPs without a local alert are blocked by a subscribed blocklist (CAPI / lists).",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "vlogs"
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "vlogs"
          },
          "expr": "app:traefik DownstreamStatus:in(403,429) OriginStatus:0 ClientHost:~\"^${ip:regex}\" | join by (ClientHost) (options(ignore_global_time_filter=true) _time:30d app:crowdsec | rename ip as ClientHost | stats by (ClientHost) count() if (kind:remediation) bans, count() if (kind:detection) detections, uniq_values(scenario) scenarios) | format \"blocklist (CAPI/lists)\" as reason | format if (detections:>0) \"AppSec\" as reason | format if (bans:>0) \"CrowdSec decision\" as reason | stats by (reason) count() requests, count_uniq(ClientHost) ips | sort by (requests desc)",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "labels",
            "format": "json",
            "replace": false,
            "keepTime": false
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Line": true,
              "id": true,
              "labels": true,
              "streams": true,
              "streamId": true
            },
            "indexByName": {
              "reason": 0,
              "requests": 1,
              "ips": 2
            },
            "renameByName": {
              "ips": "IPs"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "reason"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "CrowdSec decision": {
                        "color": "red",
                        "index": 0
                      },
                      "AppSec": {
                        "color": "orange",
                        "index": 1
                      },
                      "blocklist (CAPI/lists)": {
                        "color": "purple",
                        "index": 2
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Time"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "reason"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 165
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "requests"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 85
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "IPs"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 60
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "gridPos": {
        "x": 0,
        "y": 5,
