    {
      "type": "table",
      "title": "Hosts",
      "description": "One row per host; click a host name for its detail dashboard. Memory counts ZFS ARC as available.",
      "datasource": {
        "type": "prometheus",
        "uid": "vm"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          },
          "expr": "group by (host, role, network, zone) (up{zone=~\"$zone\",network=~\"$network\",role=~\"$role\",host=~\"$host\"})",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          },
          "expr": "sum by (host) (1 - up{zone=~\"$zone\",network=~\"$network\",role=~\"$role\",host=~\"$host\"})",
          "legendFormat": "",
          "refId": "B",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          },
          "expr": "time() - max by (host) (node_boot_time_seconds{zone=~\"$zone\",network=~\"$network\",role=~\"$role\",host=~\"$host\"})",
          "legendFormat": "",
          "refId": "C",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          },
          "expr": "100 * (1 - avg by (host) (rate(node_cpu_seconds_total{zone=~\"$zone\",network=~\"$network\",role=~\"$role\",host=~\"$host\",mode=\"idle\"}[5m])))",
          "legendFormat": "",
          "refId": "D",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          },
          "expr": "max by (host) (node_load5{zone=~\"$zone\",network=~\"$network\",role=~\"$role\",host=~\"$host\"}) / count by (host) (node_cpu_seconds_total{zone=~\"$zone\",network=~\"$network\",role=~\"$role\",host=~\"$host\",mode=\"idle\"})",
          "legendFormat": "",
          "refId": "E",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          },
          "expr": "100 * (1 - (max by (host) (node_memory_MemAvailable_bytes{zone=~\"$zone\",network=~\"$network\",role=~\"$role\",host=~\"$host\"}) + (max by (host) (node_zfs_arc_size{zone=~\"$zone\",network=~\"$network\",role=~\"$role\",host=~\"$host\"}) or max by (host) (node_memory_MemAvailable_bytes{zone=~\"$zone\",network=~\"$network\",role=~\"$role\",host=~\"$host\"}) * 0)) / max by (host) (node_memory_MemTotal_bytes{zone=~\"$zone\",network=~\"$network\",role=~\"$role\",host=~\"$host\"}))",
          "legendFormat": "",
          "refId": "F",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          },
          "expr": "max by (host) (100 * (1 - node_filesystem_avail_bytes{zone=~\"$zone\",network=~\"$network\",role=~\"$role\",host=~\"$host\",fstype!~\"tmpfs|ramfs|overlay|squashfs|nsfs|fuse.*|devtmpfs|efivarfs|autofs|tracefs|zfs\"} / node_filesystem_size_bytes{zone=~\"$zone\",network=~\"$network\",role=~\"$role\",host=~\"$host\",fstype!~\"tmpfs|ramfs|overlay|squashfs|nsfs|fuse.*|devtmpfs|efivarfs|autofs|tracefs|zfs\"}))",
          "legendFormat": "",
          "refId": "G",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          },
          "expr": "max by (host) (node_hwmon_temp_celsius{zone=~\"$zone\",network=~\"$network\",role=~\"$role\",host=~\"$host\"})",
          "legendFormat": "",
          "refId": "H",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          },
          "expr": "sum by (host) (smartctl_device_smart_status{zone=~\"$zone\",network=~\"$network\",role=~\"$role\",host=~\"$host\"} == bool 0)",
          "legendFormat": "",
          "refId": "I",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          },
          "expr": "sum by (host) (node_zfs_zpool_state{zone=~\"$zone\",network=~\"$network\",role=~\"$role\",host=~\"$host\",state!=\"online\"})",
          "legendFormat": "",
          "refId": "J",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          },
          "expr": "(count by (host) (label_replace(ALERTS{alertstate=\"firing\"}, \"host\", \"$1\", \"instance\", \"(.+)\")) and on (host) group by (host) (up{zone=~\"$zone\",network=~\"$network\",role=~\"$role\",host=~\"$host\"})) or group by (host) (up{zone=~\"$zone\",network=~\"$network\",role=~\"$role\",host=~\"$host\"}) * 0",
          "legendFormat": "",
          "refId": "K",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          },
          "expr": "sum by (host) (rate(node_network_receive_bytes_total{zone=~\"$zone\",network=~\"$network\",role=~\"$role\",host=~\"$host\",device!~\"lo|veth.*|docker.*|br-.*|virbr.*|tap.*|fwbr.*|fwpr.*|fwln.*|cali.*|flannel.*|cni.*\"}[5m]) + rate(node_network_transmit_bytes_total{zone=~\"$zone\",network=~\"$network\",role=~\"$role\",host=~\"$host\",device!~\"lo|veth.*|docker.*|br-.*|virbr.*|tap.*|fwbr.*|fwpr.*|fwln.*|cali.*|flannel.*|cni.*\"}[5m]))",
          "legendFormat": "",
          "refId": "L",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "host"
            },
            "properties": [
              {
                "id": "links",
                "value": [
