  "panels": [
    {
      "type": "stat",
      "title": "Overview: Non-ACTIVE Ports [count] / job",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "vm"
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "count(count by (job, host, device, port) (rdma_port_info{host=~\"$host\",device=~\"$device\",port=~\"$port\",state!=\"ACTIVE\"}))",
          "legendFormat": "Non-ACTIVE ports",
          "range": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          }
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "horizontal",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": 0,
                "color": "green"
              },
              {
                "value": 1,
                "color": "red"
              }
            ]
          },
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "transformations": [],
      "id": 1
    },
