    "list": [
      {
        "type": "query",
        "name": "zone",
        "label": "Zone",
        "datasource": {
          "type": "prometheus",
          "uid": "vm"
        },
        "query": {
          "query": "label_values(rdma_port_info, zone)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values(rdma_port_info, zone)",
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "hide": 0,
        "multi": true,
        "includeAll": true,
        "current": {},
        "options": [],
        "allValue": ".+"
      },
      {
