          "query": "label_values(rdma_port_info{zone=~\"$zone\"}, network)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values(rdma_port_info{zone=~\"$zone\"}, network)",
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "hide": 0,
