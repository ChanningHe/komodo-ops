    {
      "type": "table",
      "title": "Process groups",
      "description": "One row per (host, process group). CPU is % of one core (200% = two cores busy). FD limit used = worst open-fds / RLIMIT_NOFILE ratio among the group's processes. Click a column header to sort.",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 24,
        "h": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "vm"
      },
      "targets": [
        {
          "expr": "sum by (host, groupname) (rate(namedprocess_namegroup_cpu_seconds_total{host=~\"$host\",groupname=~\"$groupname\"}[$__rate_interval])) * 100",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          }
        },
        {
          "expr": "sum by (host, groupname) (namedprocess_namegroup_memory_bytes{host=~\"$host\",groupname=~\"$groupname\",memtype=\"resident\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          }
        },
        {
          "expr": "sum by (host, groupname) (namedprocess_namegroup_memory_bytes{host=~\"$host\",groupname=~\"$groupname\",memtype=\"swapped\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          }
        },
        {
          "expr": "sum by (host, groupname) (rate(namedprocess_namegroup_read_bytes_total{host=~\"$host\",groupname=~\"$groupname\"}[$__rate_interval]))",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          }
        },
        {
          "expr": "sum by (host, groupname) (rate(namedprocess_namegroup_write_bytes_total{host=~\"$host\",groupname=~\"$groupname\"}[$__rate_interval]))",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          }
        },
        {
          "expr": "sum by (host, groupname) (namedprocess_namegroup_num_procs{host=~\"$host\",groupname=~\"$groupname\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "F",
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          }
        },
        {
          "expr": "sum by (host, groupname) (namedprocess_namegroup_num_threads{host=~\"$host\",groupname=~\"$groupname\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "G",
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          }
        },
        {
          "expr": "sum by (host, groupname) (namedprocess_namegroup_open_filedesc{host=~\"$host\",groupname=~\"$groupname\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "H",
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          }
        },
        {
          "expr": "max by (host, groupname) (namedprocess_namegroup_worst_fd_ratio{host=~\"$host\",groupname=~\"$groupname\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "I",
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          }
        },
        {
          "expr": "sum by (host, groupname) (namedprocess_namegroup_states{host=~\"$host\",groupname=~\"$groupname\",state=\"Zombie\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "J",
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          }
        },
        {
          "expr": "time() - min by (host, groupname) (namedprocess_namegroup_oldest_start_time_seconds{host=~\"$host\",groupname=~\"$groupname\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "K",
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          }
