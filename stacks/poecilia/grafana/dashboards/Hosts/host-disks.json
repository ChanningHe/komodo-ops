    {
      "type": "table",
      "title": "Disk health",
      "description": "One row per (host, device). Realloc / Pending / Uncorrect / CRC are SATA attributes; Media err and wear are NVMe. smartctl rc is the smartctl exit-status bitmask (0 = clean). Any non-zero error counter is red.",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "vm"
      },
      "targets": [
        {
          "expr": "max by (host, device, model_name, serial_number, protocol) (smartctl_device{host=~\"$host\",device=~\"$device\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          }
        },
        {
          "expr": "max by (host, device) (smartctl_device_temperature{host=~\"$host\",device=~\"$device\",temperature_type=\"current\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          }
        },
        {
          "expr": "max by (host, device) (smartctl_device_smart_status{host=~\"$host\",device=~\"$device\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          }
        },
        {
          "expr": "max by (host, device) (smartctl_device_capacity_bytes{host=~\"$host\",device=~\"$device\"} > 0 or smartctl_device_nvme_capacity_bytes{host=~\"$host\",device=~\"$device\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          }
        },
        {
          "expr": "max by (host, device) (smartctl_device_power_on_seconds{host=~\"$host\",device=~\"$device\"}) / 86400",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          }
        },
        {
          "expr": "max by (host, device) (smartctl_device_percentage_used{host=~\"$host\",device=~\"$device\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "F",
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          }
        },
        {
          "expr": "max by (host, device) (smartctl_device_media_errors{host=~\"$host\",device=~\"$device\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "G",
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          }
        },
        {
          "expr": "max by (host, device) (smartctl_device_attribute{host=~\"$host\",device=~\"$device\",attribute_name=\"Reallocated_Sector_Ct\",attribute_value_type=\"raw\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "H",
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          }
        },
        {
          "expr": "max by (host, device) (smartctl_device_attribute{host=~\"$host\",device=~\"$device\",attribute_name=\"Current_Pending_Sector\",attribute_value_type=\"raw\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "I",
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          }
        },
        {
          "expr": "max by (host, device) (smartctl_device_attribute{host=~\"$host\",device=~\"$device\",attribute_name=\"Offline_Uncorrectable\",attribute_value_type=\"raw\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "J",
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          }
        },
        {
          "expr": "max by (host, device) (smartctl_device_attribute{host=~\"$host\",device=~\"$device\",attribute_name=\"UDMA_CRC_Error_Count\",attribute_value_type=\"raw\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "K",
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          }
        },
        {
          "expr": "max by (host, device) (smartctl_device_smartctl_exit_status{host=~\"$host\",device=~\"$device\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "L",
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          }
        }
      ],
