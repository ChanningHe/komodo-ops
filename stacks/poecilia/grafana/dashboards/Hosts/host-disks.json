      "type": "table",
      "title": "Hosts",
      "description": "One row per host. 'Disks with errors' counts disks with NVMe media errors / critical warnings or non-zero SATA reallocated / pending / uncorrectable sectors.",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 24,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "vm"
      },
      "targets": [
        {
          "expr": "count by (host) (smartctl_device{host=~\"$host\",device=~\"$device\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          }
        },
        {
          "expr": "sum by (host) (smartctl_device_smart_status{host=~\"$host\",device=~\"$device\"} == bool 0)",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          }
        },
        {
          "expr": "count by (host) (count by (host, device) (smartctl_device_media_errors{host=~\"$host\",device=~\"$device\"} > 0 or smartctl_device_critical_warning{host=~\"$host\",device=~\"$device\"} > 0 or smartctl_device_attribute{host=~\"$host\",device=~\"$device\",attribute_name=~\"Reallocated_Sector_Ct|Current_Pending_Sector|Offline_Uncorrectable\",attribute_value_type=\"raw\"} > 0)) or sum by (host) (smartctl_device_smart_status{host=~\"$host\",device=~\"$device\"} * 0)",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          }
        },
        {
          "expr": "max by (host) (smartctl_device_temperature{host=~\"$host\",device=~\"$device\",temperature_type=\"current\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          }
        },
        {
          "expr": "avg by (host) (smartctl_device_temperature{host=~\"$host\",device=~\"$device\",temperature_type=\"current\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          }
        },
        {
          "expr": "max by (host) (smartctl_device_percentage_used{host=~\"$host\",device=~\"$device\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "F",
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          }
        },
        {
          "expr": "min by (host) (smartctl_device_available_spare{host=~\"$host\",device=~\"$device\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "G",
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          }
        }
      ],
