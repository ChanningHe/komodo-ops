        "x": 0,
        "y": 1,
        "w": 24,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "vm"
      },
      "targets": [
        {
          "expr": "max by (host, upsBasicOutputStatus) (upsBasicOutputStatus{host=~\"$host\"} == 1)",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          }
        },
        {
          "expr": "max by (host, upsBasicBatteryStatus) (upsBasicBatteryStatus{host=~\"$host\"} == 1)",
